# ==============================================================================
# AICTE DepositLedger - Backend Environment Configuration (.env)
# ==============================================================================

# 1. Application Security
SECRET_KEY=aicte_fdr_super_secret_jwt_key_hackathon_2026_demo_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Database Connection
# Local SQLite default:
DATABASE_URL=sqlite:///./aicte_fdr.db
# Cloud PostgreSQL (e.g. Render / Supabase / AWS RDS):
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# 3. CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# 4. Storage Configuration
STORAGE_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# 5. Hackathon Demonstration Mode
DEMO_MODE=true

# 6. Optional: AWS Cloud Integration (ap-southeast-2 Sydney)
USE_AWS_S3=false
S3_BUCKET_NAME=aicte-fdr-documents-ap-southeast-2
AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

USE_AWS_SNS=false
# SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:aicte-fdr-maturity-alerts

USE_AWS_COGNITO=false
# COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
